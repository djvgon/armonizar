<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Prueba de la instrumentación</title>
<style>
/* Página de prueba del paquete: vive en la raíz de la web, junto a js/ y sonidos/, como index.html. */
:root{--bg:#f7f5fa;--panel:#fff;--fg:#1f1629;--muted:#5f5470;--line:#ddd5e8;--accent:#8a14c9;--fill:#b026ff;--soft:#efe6f8}
@media (prefers-color-scheme: dark){:root{--bg:#130c19;--panel:#1d1426;--fg:#efe7f6;--muted:#b3a6c2;--line:#3a2c48;--accent:#d08bff;--soft:#2a1d37}}
*{box-sizing:border-box} body{margin:0;background:var(--bg);color:var(--fg);font:16px/1.5 system-ui,-apple-system,"Segoe UI",sans-serif}
main{max-width:760px;margin:0 auto;padding:20px 16px 40px;display:grid;gap:18px}
h1{font-size:1.5rem;margin:0} p{margin:0} .sub{color:var(--muted);font-size:.92rem}
label{font-weight:600;font-size:.9rem;display:flex;gap:10px;align-items:center;flex-wrap:wrap}
select{font:inherit;padding:7px 10px;border-radius:8px;border:1px solid var(--line);background:var(--panel);color:var(--fg)}
.botones{display:flex;flex-wrap:wrap;gap:8px}
button{font:600 .92rem system-ui,sans-serif;padding:9px 13px;border-radius:8px;border:1px solid var(--line);background:var(--panel);color:var(--fg);cursor:pointer}
button.principal{background:var(--fill);border-color:var(--fill);color:#fff}
button:focus-visible,select:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
.acordes{display:flex;flex-wrap:wrap;gap:4px;min-height:34px}
.acorde{padding:5px 8px;border:1px solid var(--line);border-radius:7px;background:var(--panel);font-weight:600;font-variant-numeric:tabular-nums}
.acorde.suena{background:var(--soft);color:var(--accent);border-color:var(--accent)}
#estado{min-height:1.4em;color:var(--muted);font-size:.9rem}
</style>
</head>
<body>
<main>
  <h1>Prueba de la instrumentación</h1>
  <p class="sub">Comprueba el sonido.js nuevo con las mismas llamadas que hace armonizar: Sonido.secuencia con [bajo a la octava grave, bajo, tenor, contralto, soprano], solo el bajo, la melodía sola y Sonido.acorde.</p>
  <label>Instrumentación <select id="instrumento"></select></label>
  <label style="font-weight:400"><input type="checkbox" id="percusion"> Cajón y palmas con los metales por bulerías (inactivo en la aplicación; solo para probarlo)</label>
  <div class="botones" id="piezas"></div>
  <div class="botones">
    <button id="solo-bajo">Solo el bajo (A-14-06)</button>
    <button id="melodia">Melodía sola (A-8-15)</button>
    <button id="suelto">Acorde suelto (V7)</button>
    <button id="parar">■ Parar</button>
  </div>
  <div class="acordes" id="acordes" aria-hidden="true"></div>
  <p id="estado" role="status" aria-live="polite"></p>
</main>
<script>
/* Si la página se abre sin teoria.js, basta esta parte de Teoria. */
window.Teoria = window.Teoria || { midi: n => 12 * (n.octava + 1) + ({C:0,D:2,E:4,F:5,G:7,A:9,B:11})[n.letra] + n.alt };
</script>
<script src="js/sonido.js"></script>
<script>
const PIEZAS = {"mayor": {"titulo": "Do mayor: I \u2013 IV \u2013 I 6/4 \u2013 V7 \u2013 I", "etiquetas": ["I", "IV", "I 6/4", "V7", "I"], "acordes": [[72, 67, 64, 48], [72, 69, 65, 41], [72, 67, 64, 43], [71, 67, 65, 43], [72, 67, 64, 48]], "negras": [2, 2, 2, 2, 4]}, "menor": {"titulo": "la menor: i \u2013 iv \u2013 V7 \u2013 i", "etiquetas": ["i", "iv", "V7", "i"], "acordes": [[72, 69, 64, 45], [74, 69, 65, 50], [74, 68, 64, 52], [72, 69, 64, 45]], "negras": [2, 2, 2, 4]}, "A-14-06": {"titulo": "A-14-06 (18 acordes)", "etiquetas": ["la", "mi", "la", "sol", "do", "sol", "la", "re", "mi", "la", "mi", "la", "sol", "do", "sol", "la", "mi", "la"], "acordes": [[69, 64, 60, 57], [68, 64, 59, 52], [69, 64, 60, 57], [71, 67, 62, 55], [72, 67, 64, 60], [74, 71, 67, 55], [72, 69, 64, 57], [71, 69, 65, 50], [71, 68, 64, 52], [72, 69, 64, 57], [71, 68, 64, 52], [72, 69, 64, 57], [74, 71, 67, 55], [72, 67, 64, 60], [71, 67, 62, 55], [69, 64, 60, 57], [68, 64, 59, 52], [69, 64, 60, 57]], "negras": [2, 2, 2, 2, 2, 2, 1, 1, 2, 2, 2, 2, 2, 2, 2, 1, 1, 2]}, "A-8-15": {"titulo": "A-8-15 (Beethoven, op. 14 n.\u00ba 2, II)", "etiquetas": ["do", "re", "mi", "si", "do", "fa", "sol"], "acordes": [[72, 67, 64, 48], [71, 67, 65, 50], [72, 67, 64, 52], [74, 67, null, 47], [76, 72, 67, 48], [77, 74, 69, 53], [74, 71, 67, 55]], "negras": [1, 1, 1, 1, 1, 1, 2]}};
const NOMBRES = [['C',0],['C',1],['D',0],['E',-1],['E',0],['F',0],['F',1],['G',0],['G',1],['A',0],['B',-1],['B',0]];
const nota = m => ({ letra: NOMBRES[((m % 12) + 12) % 12][0], alt: NOMBRES[((m % 12) + 12) % 12][1], octava: Math.floor(m / 12) - 1 });
const conBajoDoblado = (b, voces) => [nota(b - 12), nota(b), ...voces.map(nota)];   // como app.js
const sel = document.getElementById('instrumento'), estado = document.getElementById('estado');
// El menú «Instrumentación», agrupado: así lo puede montar app.js con Sonido.GRUPOS.
Sonido.GRUPOS.forEach(gr => {
  const og = document.createElement('optgroup'); og.label = gr;
  Sonido.INSTRUMENTOS.filter(x => x.grupo === gr).forEach(x => { const o = document.createElement('option'); o.value = x.id; o.textContent = x.nombre; og.appendChild(o); });
  sel.appendChild(og);
});
sel.value = Sonido.instrumentoActual();
sel.addEventListener('change', () => { Sonido.parar(); Sonido.elegirInstrumento(sel.value); });
document.getElementById('percusion').addEventListener('change', e => { Sonido.parar(); Sonido.ajustes.percusionBulerias = e.target.checked; });
Sonido.alCargar = (id, listo) => { estado.textContent = listo ? '' : 'cargando ' + Sonido.INSTRUMENTOS.find(x => x.id === id).nombre + '…'; };
['pointerdown', 'keydown', 'touchstart'].forEach(ev => document.addEventListener(ev, () => Sonido.desbloquear(), { once: true, passive: true }));
function pintar(etq) { document.getElementById('acordes').innerHTML = etq.map(e => '<span class="acorde">' + e + '</span>').join(''); }
function marcar(i) { document.querySelectorAll('.acorde').forEach((a, j) => a.classList.toggle('suena', i === j)); }
function tocar(items, etq) { pintar(etq); Sonido.secuencia(items.map((it, i) => ({ ...it, alEmpezar: () => marcar(i) })), () => marcar(-1)); }
// [S, A, T, B] de las piezas → lo que manda app.js
const itemsDe = (pz, que) => pz.acordes.map((ac, i) => {
  const [S, A, T, B] = ac, voces = [T, A, S].filter(x => x != null);
  const notas = que === 'bajo' ? conBajoDoblado(B, []) : que === 'melodia' ? [nota(S)] : conBajoDoblado(B, voces);
  return { notas, segundos: 0.6 * pz.negras[i] };
});
Object.entries(PIEZAS).forEach(([id, pz]) => {
  const b = document.createElement('button'); b.className = 'principal'; b.textContent = pz.titulo; b.id = 'p-' + id;
  b.addEventListener('click', () => tocar(itemsDe(pz, 'todo'), pz.etiquetas));
  document.getElementById('piezas').appendChild(b);
});
document.getElementById('solo-bajo').addEventListener('click', () => tocar(itemsDe(PIEZAS['A-14-06'], 'bajo'), PIEZAS['A-14-06'].etiquetas));
document.getElementById('melodia').addEventListener('click', () => tocar(itemsDe(PIEZAS['A-8-15'], 'melodia'), PIEZAS['A-8-15'].etiquetas));
document.getElementById('suelto').addEventListener('click', () => { pintar(['V7']); Sonido.acorde(conBajoDoblado(43, [65, 67, 71]), 1.4); });
document.getElementById('parar').addEventListener('click', () => { Sonido.parar(); marcar(-1); });
</script>
</body>
</html>
